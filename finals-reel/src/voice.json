{
 "duration": 25.76,
 "sentences": [
  {
   "text": "Над петдесет отбора.",
   "at": 0.45,
   "end": 1.81,
   "parts": [
    [
     0.45,
     1.81
    ]
   ]
  },
  {
   "text": "Над двеста играчи.",
   "at": 2.43,
   "end": 3.47,
   "parts": [
    [
     2.43,
     2.59
    ],
    [
     3.01,
     3.47
    ]
   ]
  },
  {
   "text": "Пет града. Една седмица.",
   "at": 4.09,
   "end": 5.77,
   "parts": [
    [
     4.09,
     4.44
    ],
    [
     5.1,
     5.77
    ]
   ]
  },
  {
   "text": "В някои градове решаваха секундите.",
   "at": 6.39,
   "end": 8.45,
   "parts": [
    [
     6.39,
     7.13
    ],
    [
     7.54,
     8.45
    ]
   ]
  },
  {
   "text": "В други — разликата беше убедителна.",
   "at": 9.07,
   "end": 10.96,
   "parts": [
    [
     9.07,
     9.49
    ],
    [
     9.84,
     10.96
    ]
   ]
  },
  {
   "text": "Много за малко. Всичко — на косъм.",
   "at": 11.58,
   "end": 13.29,
   "parts": [
    [
     11.58,
     12.14
    ],
    [
     12.83,
     13.29
    ]
   ]
  },
  {
   "text": "Само осем отбора продължават.",
   "at": 13.91,
   "end": 15.3,
   "parts": [
    [
     13.91,
     15.3
    ]
   ]
  },
  {
   "text": "Едно е сигурно — финалът ще е оспорван до последната секунда.",
   "at": 15.92,
   "end": 19.23,
   "parts": [
    [
     15.92,
     16.47
    ],
    [
     17.22,
     18.08
    ],
    [
     18.4,
     19.23
    ]
   ]
  },
  {
   "text": "Седми ноември. София.",
